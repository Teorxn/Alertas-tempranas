# Copiar las variables que se usen al entorno (o a un .env local, ignorado por Git).

# Secreto para firmar sesiones/CSRF: cambiarlo por uno aleatorio y MANTENERLO estable.
EWS_SECRET_KEY=cambia-esta-clave-por-una-cadena-aleatoria-larga

# Base de datos (SQLite por defecto; en producción usar PostgreSQL).
EWS_DATABASE_URL=sqlite:///data/ews.db

# Seguridad de cookies y orígenes.
EWS_COOKIE_SECURE=0
EWS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EWS_SESSION_HOURS=8
EWS_IDLE_MINUTES=30
EWS_LOGIN_MAX_FAILURES=5
EWS_LOGIN_WINDOW_MINUTES=15

# LLM (resumen narrativo). Se prefiere Gemini; OpenAI es respaldo.
# Sin ninguna clave se usan plantillas automáticas. NUNCA subir la clave real.
GEMINI_API_KEY=
EWS_GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
EWS_OPENAI_MODEL=gpt-4o-mini
EWS_LLM_ENABLED=1
EWS_LLM_MAX_CALLS=25

# Carga inicial de datos de ejemplo.
EWS_SEED_PASSWORD=ClaveSegura123!

# Frontend Next.js.
API_UPSTREAM=http://127.0.0.1:8000
API_INTERNAL_URL=http://127.0.0.1:8000
